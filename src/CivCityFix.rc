#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CCF_VERSION_MAJOR, CCF_VERSION_MINOR, CCF_VERSION_PATCH, 0
 PRODUCTVERSION CCF_VERSION_MAJOR, CCF_VERSION_MINOR, CCF_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Christian Munch"
            VALUE "FileDescription", "CivCityFix: Direct3D 9 proxy for CivCity: Rome (loads DXVK)"
            VALUE "FileVersion", CCF_VERSION_STR
            VALUE "InternalName", "CivCityFix"
            VALUE "LegalCopyright", "Copyright (c) 2026 Christian Munch. MIT License. Unofficial fan fix."
            VALUE "OriginalFilename", "d3d9.dll"
            VALUE "ProductName", "CivCityFix"
            VALUE "ProductVersion", CCF_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
